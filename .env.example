# Copia este archivo como ".env" y rellena tu clave de OpenAI.
# El archivo .env NO se sube al repositorio (esta en .gitignore).

OPENAI_API_KEY=sk-tu-clave-aqui

# Opcional: modelo de chat para el resumen (por defecto gpt-4o-mini)
# OPENAI_SUMMARY_MODEL=gpt-4o-mini

# Opcional: modelo de transcripcion (por defecto whisper-1)
# OPENAI_TRANSCRIBE_MODEL=whisper-1
